# macOS
.DS_Store
**/.DS_Store

# Claude Code local session state
.claude/settings.local.json
.claude/.triage-fix-last*.json
.claude/test-cmd
.claude/context.md

# Chain runtime artifacts (machine-local, never commit)
.claude/step5-report.json
.claude/nightly-report.json
.claude/scheduled_tasks.lock
.claude/agent-memory-local/
.claude/worktrees/
.claude/nightly-state/
*.bak
*.bak-*

# Reference material (local reading copies, not repo content).
# Directory contents are ignored, not the directory itself — a `docs/books/` pattern would
# exclude the parent and make the negation below inert (git cannot re-include a file whose
# parent directory is excluded). The integration report is repo content and is tracked.
docs/books/*
!docs/books/INTEGRATION-REPORT-agentic-spec.md

# Session memory (runtime, not source of truth)
.remember/logs/
.remember/tmp/
.remember/now.md
.remember/today-*.md
.remember/recent.md
.remember/archive.md
.remember/remember.md
.claude/.triage-fix-last-*.json
